# Supabase Project Configuration
# Replace these placeholder values with your actual project credentials

# Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (SECRET: Required for server-side import to bypass RLS)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# NEVER expose this key in frontend code or commit to source control!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Anon / Publishable Key (Safe for frontend read operations)
# Found in Project Settings -> API -> Project API keys -> anon / publishable
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
